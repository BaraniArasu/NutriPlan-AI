# ─── Database ─────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/dietapp?sslmode=require"

# ─── NextAuth ─────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-secret-here"

# App URL - MUST match exactly what you use in browser
NEXTAUTH_URL="http://localhost:3000"

# ─── Google OAuth ──────────────────────────────────────────
# In Google Cloud Console → APIs & Services → Credentials
# Authorized redirect URIs must include EXACTLY:
#   http://localhost:3000/api/auth/callback/google   (for local dev)
#   https://yourdomain.com/api/auth/callback/google  (for production)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your-secret"

# ─── AI Provider ────────────────────────────────────────────
# Which model powers diet-plan generation and chat. Switch anytime — no code
# changes needed. Options: groq | openai | gemini | anthropic
# Defaults to "groq" (free) so the app works out of the box for testing.
AI_PROVIDER="groq"

# Groq (free) — get a key from https://console.groq.com
GROQ_API_KEY="gsk_your-key-here"
GROQ_MODEL="llama-3.3-70b-versatile"

# OpenAI (ChatGPT) — get a key from https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-your-key-here"
OPENAI_MODEL="gpt-4o-mini"

# Google Gemini — get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.0-flash"

# Anthropic (Claude) — get a key from https://console.anthropic.com
ANTHROPIC_API_KEY="sk-ant-your-key-here"
ANTHROPIC_MODEL="claude-opus-4-8"

# ─── App ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
